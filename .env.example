APP_NAME=AIPAL LAB Analysis API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
# CORS (A: Next.js dashboard), comma separated
CORS_ORIGINS=http://localhost:3000
# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
# C: Python calculation engine
CALC_ENGINE_URL=http://localhost:8100
CALC_TIMEOUT_SECONDS=30
CALC_DATASET_ID=commercial_area_v1
# http = real engine, mock = dev/test only (blocked when APP_ENV=production)
CALC_MODE=http
# A(dashboard) auth: request header X-API-Key. Generate: python -c "import secrets;print(secrets.token_hex(24))"
API_KEY=
# 최신 분기: 평소엔 C 엔진 /health 에서 읽고, 못 읽을 때만 이 값을 쓴다 ("최근", "올해" 해석에 사용)
LATEST_QUARTER=2026Q2
# 질문 해석(구조화 출력)은 짧아야 정상. 넘으면 모델 없이 서버 규칙으로 처리
PLAN_TIMEOUT_SECONDS=30
PLAN_MAX_TOKENS=400
# 설명이 늦으면 계산 결과를 그대로 나열한 문장으로 대체
EXPLAIN_TIMEOUT_SECONDS=60
EXPLAIN_MAX_TOKENS=700
# 관용 표현의 의미 해석 순서: model_first(모델 > 알려진 표현) | rules_first. scripts/eval_planner.py 점수로 정한다
CONCEPT_PRIORITY=model_first
# 모델이 쓰는 해석 문장(기본 꺼짐). 켜면 숫자·추천·"없다"·목록 재나열을 검사하지만 정성적 비교 오류는 못 거른다
EXPLAIN_INTERPRETATION=false
